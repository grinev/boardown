{
  "name": "@boardown/electron",
  "version": "0.12.0",
  "minCompatibleVersion": "0.12.0",
  "private": true,
  "description": "boardown desktop app — a local-first Markdown task board.",
  "license": "MIT",
  "author": "Ruslan Grinev <grinevruslan@gmail.com>",
  "homepage": "https://github.com/grinev/boardown",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node esbuild.mjs",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "watch:main": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "pnpm build && electron-builder"
  },
  "dependencies": {
    "@boardown/core": "workspace:*",
    "@boardown/ui": "workspace:*",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.10.0",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.25.12",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
